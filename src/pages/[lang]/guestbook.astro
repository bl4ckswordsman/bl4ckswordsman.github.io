---
// ═══════════════════════════════════════════════════════
//  Guestbook page — GitHub Discussions via Giscus
// ═══════════════════════════════════════════════════════
import type { Locale } from '@/i18n/locales';
import { SUPPORTED_LOCALES } from '@/i18n/locales';
import { useTranslations } from '@/i18n/i18n';
import Layout from '@/layouts/Layout.astro';
import GiscusComments from '@/components/GiscusComments.astro';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---
<Layout
  lang={lang}
  title={`bl4ckswordsman | ${t('guestbook', 'title')}`}
  description={t('guestbook', 'subtitle')}
  page="guestbook"
>
  <div class="container page-section">
    <div class="scroll-reveal">
      <h1>{t('guestbook', 'title')}</h1>
      <p class="subtitle">{t('guestbook', 'subtitle')}</p>
    </div>

    <div class="scroll-reveal">
      <GiscusComments lang={lang} />
    </div>
  </div>
</Layout>

<style>
  .subtitle {
    color: var(--text-secondary);
    margin-block-start: var(--space-xs);
    margin-block-end: var(--space-xl);
  }
</style>
