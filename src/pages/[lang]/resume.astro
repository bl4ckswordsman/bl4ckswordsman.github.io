---
// ═══════════════════════════════════════════════════════
//  Résumé page — powered by Reactive Resume (rxresu.me)
//  Fetches the public JSON export at build time.
//  Static output: no client-side API calls needed.
// ═══════════════════════════════════════════════════════
import type { Locale } from '@/i18n/locales';
import { SUPPORTED_LOCALES } from '@/i18n/locales';
import { useTranslations } from '@/i18n/i18n';
import Layout from '@/layouts/Layout.astro';
import { portfolio } from '@/data/portfolio'; // used for fallback

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

// ── Reactive Resume public share details ────────────────
const RXRESUME_USERNAME = 'blackswordsman';
const RXRESUME_SLUG     = 'a-r-resume';

interface RxResumeExperienceItem {
  id: string;
  hidden?: boolean;
  position?: string;
  company?: string;
  period?: string;
  location?: string;
  description?: string;
}

interface RxResumeEducationItem {
  id: string;
  hidden?: boolean;
  degree?: string;
  area?: string;
  school?: string;
  period?: string;
  location?: string;
  description?: string;
}

interface RxResumeSkillItem {
  id: string;
  hidden?: boolean;
  name?: string;
  proficiency?: string;
  keywords?: string[];
}

interface RxResumeLanguageItem {
  id: string;
  hidden?: boolean;
  language?: string;
  fluency?: string;
  level?: number;
}

interface RxResumeCertificationItem {
  id: string;
  hidden?: boolean;
  title?: string;
  issuer?: string;
  date?: string;
  website?: { url?: string; label?: string };
  description?: string;
}

interface RxResumeProjectItem {
  id: string;
  hidden?: boolean;
  name?: string;
  period?: string;
  website?: { url?: string; label?: string };
  description?: string;
}

let rxData: any = null;
let lastUpdated = '';

if (RXRESUME_USERNAME && RXRESUME_SLUG) {
  try {
    const res = await fetch('https://rxresu.me/api/orpc/resume.getBySlug', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        json: { username: RXRESUME_USERNAME, slug: RXRESUME_SLUG },
      }),
    });
    if (res.ok) {
      const raw = await res.json();
      rxData = raw?.data || raw;
      if (rxData?.updatedAt) {
        lastUpdated = new Intl.DateTimeFormat(lang, { dateStyle: 'medium' }).format(
          new Date(rxData.updatedAt)
        );
      }
    }
  } catch {
    // Falls back to static data below
  }
}

// Extracted fields (with fallback)
const name     = rxData?.basics?.name     || rxData?.name || 'Amarildo';
const headline = rxData?.basics?.headline || t('hero', 'tagline');
const email    = rxData?.basics?.email    || portfolio.email || '';
const summary  = rxData?.basics?.summary  || '';

// Helper to filter non-hidden section items
function getRxItems<T extends { hidden?: boolean }>(sectionKey: string): T[] {
  const items: T[] = rxData?.sections?.[sectionKey]?.items || [];
  return items.filter((item) => !item.hidden);
}

const rxExperience    = getRxItems<RxResumeExperienceItem>('experience');
const rxEducation     = getRxItems<RxResumeEducationItem>('education');
const rxSkills        = getRxItems<RxResumeSkillItem>('skills');
const rxLanguages     = getRxItems<RxResumeLanguageItem>('languages');
const rxCertifications = getRxItems<RxResumeCertificationItem>('certifications');
const rxProjects       = getRxItems<RxResumeProjectItem>('projects');

const useStatic = !rxData;
---
<Layout
  lang={lang}
  title={`bl4ckswordsman | ${t('resume', 'title')}`}
  description={headline}
  page="resume"
>
  <div class="container page-section">

    <!-- Header -->
    <div class="resume-header scroll-reveal">
      <div class="resume-header__text">
        <h1>{name}</h1>
        {headline && <p class="resume-header__headline">{headline}</p>}
        {summary  && <div class="resume-header__summary" set:html={summary} />}
      </div>

      <div class="resume-header__actions">
        {RXRESUME_USERNAME && RXRESUME_SLUG && (
          <a
            href={`https://rxresu.me/${RXRESUME_USERNAME}/${RXRESUME_SLUG}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary"
          >
            {t('resume', 'view_original')} ↗
          </a>
        )}
        {portfolio.socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" class="btn btn--outline" aria-label={s.label}>
            {s.iconPath && (
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={s.iconPath} />
              </svg>
            )}
            {s.platform}
          </a>
        ))}
        {email && (
          <a href={`mailto:${email}`} class="btn btn--outline">✉ {t('resume', 'contact')}</a>
        )}
      </div>

      {lastUpdated && (
        <p class="resume-header__updated">
          <span class="tag">{t('resume', 'present')} · {lastUpdated}</span>
        </p>
      )}
    </div>

    {/* ── Reactive Resume live data ── */}
    {rxData ? (
      <>
        {/* Skills */}
        {rxSkills.length > 0 && (
          <section class="page-section scroll-reveal" aria-labelledby="skills-heading">
            <h2 id="skills-heading" class="section-heading">{t('resume', 'skills')}</h2>
            <div class="skills-sections">
              {rxSkills.map((group) => (
                <div class="skill-group">
                  <h3 class="skill-group__title">{group.name}</h3>
                  <div class="skills-grid">
                    {group.keywords?.map((k) => (
                      <span class="tag">{k}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {/* Experience */}
        {rxExperience.length > 0 && (
          <section class="page-section scroll-reveal" aria-labelledby="exp-heading">
            <h2 id="exp-heading" class="section-heading">{t('resume', 'experience')}</h2>
            <div class="timeline-list">
              {rxExperience.map((e) => (
                <details class="timeline-item">
                  <summary>
                    <div>
                      <div class="timeline-item__title">{e.position || e.company}</div>
                      {e.company && e.position && (
                        <div class="timeline-item__meta">
                          {e.company}{e.location ? ` · ${e.location}` : ''}
                        </div>
                      )}
                    </div>
                    {e.period && <span class="tag" style="flex-shrink:0">{e.period}</span>}
                  </summary>
                  {e.description && (
                    <div class="timeline-item__body">
                      <div set:html={e.description} />
                    </div>
                  )}
                </details>
              ))}
            </div>
          </section>
        )}

        {/* Education */}
        {rxEducation.length > 0 && (
          <section class="page-section scroll-reveal" aria-labelledby="edu-heading">
            <h2 id="edu-heading" class="section-heading">{t('resume', 'education')}</h2>
            <div class="timeline-list">
              {rxEducation.map((e) => {
                const title = [e.degree, e.area].filter(Boolean).join(' in ') || e.school;
                return (
                  <details class="timeline-item">
                    <summary>
                      <div>
                        <div class="timeline-item__title">{title}</div>
                        {e.school && title !== e.school && (
                          <div class="timeline-item__meta">{e.school}{e.location ? ` · ${e.location}` : ''}</div>
                        )}
                      </div>
                      {e.period && <span class="tag" style="flex-shrink:0">{e.period}</span>}
                    </summary>
                    {e.description && (
                      <div class="timeline-item__body">
                        <div set:html={e.description} />
                      </div>
                    )}
                  </details>
                );
              })}
            </div>
          </section>
        )}

        {/* Certifications */}
        {rxCertifications.length > 0 && (
          <section class="page-section scroll-reveal" aria-labelledby="cert-heading">
            <h2 id="cert-heading" class="section-heading">Certifications</h2>
            <div class="timeline-list">
              {rxCertifications.map((c) => (
                <div class="timeline-item" style="padding: var(--space-md) var(--space-lg);">
                  <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:var(--space-md);">
                    <div>
                      <div class="timeline-item__title">
                        {c.website?.url ? (
                          <a href={c.website.url} target="_blank" rel="noopener noreferrer">
                            {c.title} ↗
                          </a>
                        ) : (
                          c.title
                        )}
                      </div>
                      {c.issuer && <div class="timeline-item__meta">{c.issuer}</div>}
                    </div>
                    {c.date && <span class="tag" style="flex-shrink:0">{c.date}</span>}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {/* Languages */}
        {rxLanguages.length > 0 && (
          <section class="page-section scroll-reveal" aria-labelledby="langs-heading">
            <h2 id="langs-heading" class="section-heading">{t('resume', 'languages')}</h2>
            <div class="lang-list">
              {rxLanguages.map((l) => (
                <div class="lang-item">
                  <span class="lang-item__name">{l.language}</span>
                  {l.fluency && <span class="lang-badge lang-badge--fluent">{l.fluency}</span>}
                </div>
              ))}
            </div>
          </section>
        )}
      </>
    ) : useStatic ? (
      <>
        {/* Fallback: static portfolio data */}
        <section class="page-section scroll-reveal" aria-labelledby="skills-heading">
          <h2 id="skills-heading" class="section-heading">{t('resume', 'skills')}</h2>
          <div class="skills-grid">
            {portfolio.skills.map((s) => (
              <span class={`tag tag--${s.category}`}>{s.name}</span>
            ))}
          </div>
        </section>

        <section class="page-section scroll-reveal" aria-labelledby="exp-heading">
          <h2 id="exp-heading" class="section-heading">{t('resume', 'experience')}</h2>
          <div class="timeline-list">
            {portfolio.experience.map((e) => (
              <details class="timeline-item">
                <summary>
                  <div>
                    <div class="timeline-item__title">{e.title}</div>
                    <div class="timeline-item__meta">{e.organisation}</div>
                  </div>
                  <span class="tag" style="flex-shrink:0">
                    {e.startDate} — {e.endDate ?? t('resume', 'present')}
                  </span>
                </summary>
                {e.highlights?.length && (
                  <div class="timeline-item__body">
                    <ul class="timeline-item__highlights">
                      {e.highlights.map((h) => <li>{h}</li>)}
                    </ul>
                  </div>
                )}
              </details>
            ))}
          </div>
        </section>

        <section class="page-section scroll-reveal" aria-labelledby="edu-heading">
          <h2 id="edu-heading" class="section-heading">{t('resume', 'education')}</h2>
          <div class="timeline-list">
            {portfolio.education.map((e) => (
              <details class="timeline-item">
                <summary>
                  <div>
                    <div class="timeline-item__title">{e.title}</div>
                    <div class="timeline-item__meta">{e.organisation}</div>
                  </div>
                  <span class="tag" style="flex-shrink:0">
                    {e.startDate} — {e.endDate ?? t('resume', 'present')}
                  </span>
                </summary>
                {e.highlights?.length && (
                  <div class="timeline-item__body">
                    <ul class="timeline-item__highlights">
                      {e.highlights.map((h) => <li>{h}</li>)}
                    </ul>
                  </div>
                )}
              </details>
            ))}
          </div>
        </section>

        <section class="page-section scroll-reveal" aria-labelledby="langs-heading">
          <h2 id="langs-heading" class="section-heading">{t('resume', 'languages')}</h2>
          <div class="lang-list">
            {portfolio.spokenLanguages.map((l) => (
              <div class="lang-item">
                <span class="lang-item__name">{l.name}</span>
                <span class={`lang-badge lang-badge--${l.level}`}>{l.level}</span>
              </div>
            ))}
          </div>
        </section>
      </>
    ) : (
      <div class="empty-state">
        <div class="empty-state__icon">⚠️</div>
        <h2>Résumé unavailable</h2>
        <p>Could not load résumé data from Reactive Resume. Try again later.</p>
      </div>
    )}
  </div>
</Layout>

<style>
  .resume-header {
    margin-block-end: var(--space-2xl);
    display: grid;
    gap: var(--space-md);
  }

  .resume-header__headline {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--accent-cyan);
    font-weight: 500;
    margin-block-start: var(--space-xs);
  }

  .resume-header__summary {
    color: var(--text-secondary);
    line-height: 1.7;
    max-inline-size: 70ch;
    margin-block-start: var(--space-sm);
  }

  .resume-header__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .resume-header__updated {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .timeline-item__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
  }

  .skill-group__title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-block-end: var(--space-xs);
  }

  .skills-sections {
    display: grid;
    gap: var(--space-lg);
  }

  .lang-list { max-inline-size: 600px; }
</style>
