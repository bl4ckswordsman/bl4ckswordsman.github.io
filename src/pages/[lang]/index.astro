---
// ═══════════════════════════════════════════════════════
//  Home page — Hero
// ═══════════════════════════════════════════════════════
import type { Locale } from '@/i18n/locales';
import { SUPPORTED_LOCALES, getLocalePath } from '@/i18n/locales';
import { useTranslations } from '@/i18n/i18n';
import Layout from '@/layouts/Layout.astro';
import { portfolio } from '@/data/portfolio';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---
<Layout
  lang={lang}
  title="bl4ckswordsman — Amarildo"
  description={t('hero', 'tagline')}
  page=""
>
  <section class="hero container">
    <div class="scroll-reveal">
      <p class="hero__greeting">
        {t('hero', 'greeting')}
        <strong class="hero__name-inline">{t('hero', 'name')}</strong>
        <span class="hero__aka">, {t('hero', 'aka')} <em class="hero__handle">{t('hero', 'handle')}</em></span>
      </p>
      <p class="hero__tagline">{t('hero', 'tagline')}</p>
    </div>

    <div class="hero__ctas scroll-reveal">
      {portfolio.socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--primary"
          aria-label={`${social.label} — ${t('a11y', 'external_link')}`}
        >
          {social.iconPath && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={social.iconPath} />
            </svg>
          )}
          {social.platform}
        </a>
      ))}
      <a href={getLocalePath(lang, '/resume')} class="btn btn--outline">
        {t('hero', 'cta_resume')}
      </a>
    </div>

    <!-- Decorative grid pattern (CSS-only) -->
    <div class="hero__decoration" aria-hidden="true"></div>
  </section>

  <!-- Quick stats strip -->
  <section class="container page-section scroll-reveal">
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat__value">{portfolio.skills.length}+</span>
        <span class="hero-stat__label">Skills</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat__value">{portfolio.experience.length}+</span>
        <span class="hero-stat__label">Roles</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat__value">{portfolio.spokenLanguages.length}</span>
        <span class="hero-stat__label">Languages</span>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: var(--space-3xl);
    display: grid;
    gap: var(--space-xl);
    position: relative;
    overflow: hidden;
  }

  /* Greeting line */
  .hero__greeting {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    color: var(--text-secondary);
    font-weight: 400;
    margin-block-end: var(--space-xs);
  }

  .hero__name-inline {
    color: var(--text-primary);
    font-weight: 700;
    font-size: clamp(1.2rem, 3.5vw, 1.7rem);
  }

  .hero__aka {
    font-size: 0.85em;
    color: var(--text-muted);
    font-weight: 400;
  }

  .hero__handle {
    font-family: var(--font-mono);
    font-style: normal;
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 2.5vw, 1.2rem);
    color: var(--text-secondary);
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-block-start: var(--space-sm);
  }

  /* Brutalist grid decoration */
  .hero__decoration {
    position: absolute;
    inset-inline-end: -4rem;
    inset-block-start: 50%;
    translate: 0 -50%;
    inline-size: min(500px, 50vw);
    aspect-ratio: 1;
    background-image:
      linear-gradient(var(--border-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.06;
    pointer-events: none;
    z-index: -1;
  }

  /* Hero stats */
  .hero-stats {
    display: flex;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .hero-stat__value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1;
    color: var(--accent-cyan);
  }

  .hero-stat__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
</style>
